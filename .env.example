# Instagram credentials (required)
INSTAGRAM_USERNAME=your_username_here
INSTAGRAM_PASSWORD=your_password_here

# Mode: set to "false" to perform real actions (default: true)
# DRY_RUN=true

# Cycle interval in hours (default: 48)
# CYCLE_INTERVAL_HOURS=48

# Set to "true" to run once and exit instead of looping
# RUN_ONCE=false

# Rate limits — conservative defaults for new accounts
# MAX_UNFOLLOWS_PER_CYCLE=30
# MAX_WITHDRAWALS_PER_CYCLE=15
# DELAY_MIN=30
# DELAY_MAX=60
# ACTIONS_BEFORE_BREAK=5

# Grace periods (days)
# NON_FOLLOWER_GRACE_DAYS=2
# PENDING_REQUEST_STALE_DAYS=3
